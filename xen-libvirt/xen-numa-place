#!/usr/bin/env python3
"""xen-numa-place — placement NUMA automatique des VM Xen gérées par libvirt (libxl),
dom0 Debian 13 : vCPU et mémoire sur le(s) même(s) nœud(s).

  xen-numa-place plan [--rebalance] [--cores-only]
  xen-numa-place apply [--live] [--rebalance] [--cores-only] [VM...]
  xen-numa-place status

Règles (calcul dans numa_core.py, topologie lue par numa_xen.py via « xl info -n ») :
  - VM avec <hostdev> PCI, <interface type='hostdev'> ou réseau SR-IOV -> nœud de la carte
  - VM sans passthrough -> nœud(s) le(s) moins chargé(s), puis conservé(s)
  - VM plus grande qu'un nœud -> plusieurs nœuds CONTIGUS
  - <np:place mode="manual"/>, ou cpuset posé à la main sans marque -> ignorée

Application : <vcpu cpuset=…> (affinité dure) ; libxl en déduit l'affinité de nœud
et y alloue la mémoire au démarrage suivant. La marque <np:place mode="auto"/> va
dans <metadata>. --live épingle aussi les vCPU tout de suite (xl vcpu-pin).

Ballooning : <currentMemory> plus petit que <memory> = mémoire garantie ; c'est elle
qui compte dans la charge des nœuds.

Équilibrage sur la charge réelle : consommation CPU mesurée (--sample S secondes,
xl list) et lissée dans STATE ; une petite VM sur des nœuds saturés est évacuée à
chaud (--live), puis ne rebouge pas avant 10 minutes.
"""
import argparse
import os
import sys
import tempfile
import time
import xml.etree.ElementTree as ET
from typing import Dict, List, NamedTuple, Optional, Tuple


def _import_libs():
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (here, os.path.dirname(here), "/usr/local/lib/numa-place"):
        if os.path.exists(os.path.join(d, "numa_core.py")):
            sys.path.insert(0, d)
            break


_import_libs()
import numa_core as core  # noqa: E402
import numa_state as st  # noqa: E402
import numa_xen as xen  # noqa: E402

URI = os.environ.get("XNP_URI", "xen:///system")
SYSFS = os.environ.get("XNP_SYSFS", "/sys")
STATE = os.environ.get("XNP_STATE", "/var/lib/numa-place/xen-state.json")
NS = "urn:numa-place:1"
ET.register_namespace("np", NS)
MEM_UNITS = {"b": 1, "bytes": 1, "KiB": 2**10, "k": 2**10, "MiB": 2**20, "M": 2**20,
             "GiB": 2**30, "G": 2**30, "TiB": 2**40, "T": 2**40}


def log(msg: str) -> None:
    print("xen-numa-place: " + msg, file=sys.stderr)


def virsh(run: xen.Runner, *args: str) -> Optional[str]:
    return run(["virsh", "-q", "-c", URI] + list(args))


class Vm(NamedTuple):
    name: str
    xml: str                   # définition persistante (--inactive)
    vcpus: int
    mem_mb: int
    pci: Tuple[str, ...]
    cpuset: Tuple[int, ...]    # () si absent
    mode: str                  # "auto" | "manual" | ""
    running: bool
    mem_min_mb: int = 0        # <currentMemory> (cible du ballooning) si < <memory>
    domid: str = ""            # change à chaque démarrage (RAM réallouée)

    @property
    def guaranteed_mb(self) -> int:
        return self.mem_min_mb or self.mem_mb

    @property
    def elastic(self) -> bool:
        return 0 < self.mem_min_mb < self.mem_mb


# ---------------------------------------------------------------- lecture

def _pci_addr(addr: ET.Element) -> str:
    vals = [int(addr.get(k, "0"), 0) for k in ("domain", "bus", "slot", "function")]
    return "{:04x}:{:02x}:{:02x}.{:x}".format(*vals)


def _pool_addr(run: xen.Runner, network: str) -> Optional[str]:
    """Carte d'un réseau libvirt <forward mode='hostdev'> -> adresse PCI.

    Le pool peut lister ses VF (<address …/>, seule forme qui marche avec une
    Chelsio, dont les VF sont sous les PF 0-3) ou nommer la PF (<pf dev=…/>).
    La VM reçoit une VF quelconque du pool : la première sert de référence."""
    text = virsh(run, "net-dumpxml", network)
    if not text:
        return None
    forward = ET.fromstring(text).find("./forward[@mode='hostdev']")
    if forward is None:
        return None
    vf = forward.find("address[@type='pci']")
    if vf is not None:
        return _pci_addr(vf)
    pf = forward.find("pf")
    if pf is None or not pf.get("dev"):
        return None
    real = os.path.realpath(os.path.join(SYSFS, "class/net", pf.get("dev"), "device"))
    return os.path.basename(real) if os.path.exists(real) else None


def pci_of(root: ET.Element, run: xen.Runner) -> Tuple[str, ...]:
    addrs = [_pci_addr(a) for a in root.findall("./devices/hostdev[@type='pci']/source/address")]
    addrs += [_pci_addr(a) for a in root.findall("./devices/interface[@type='hostdev']/source/address")]
    for src in root.findall("./devices/interface[@type='network']/source"):
        card = _pool_addr(run, src.get("network", ""))
        if card and card not in addrs:
            addrs.append(card)
    return tuple(addrs)


def _bytes(elem: Optional[ET.Element]) -> int:
    if elem is None or not (elem.text or "").strip():
        return 0
    return int(elem.text) * MEM_UNITS.get(elem.get("unit", "KiB"), 2**10)


def load_vm(run: xen.Runner, name: str) -> Vm:
    text = virsh(run, "dumpxml", "--inactive", name) or "<domain/>"
    root = ET.fromstring(text)
    vcpu = root.find("vcpu")
    mem_bytes = _bytes(root.find("memory"))
    cur_bytes = _bytes(root.find("currentMemory"))
    mark = root.find("./metadata/{%s}place" % NS)
    domid = (virsh(run, "domid", name) or "").strip()
    return Vm(
        name=name, xml=text,
        vcpus=int(vcpu.text) if vcpu is not None else 1,
        mem_mb=mem_bytes // 2**20,
        pci=pci_of(root, run),
        cpuset=core.parse_cpulist(vcpu.get("cpuset")) if vcpu is not None and vcpu.get("cpuset") else (),
        mode=mark.get("mode", "") if mark is not None else "",
        running=domid.isdigit(),
        mem_min_mb=cur_bytes // 2**20 if 0 < cur_bytes < mem_bytes else 0,
        domid=domid if domid.isdigit() else "",
    )


def load_vms(run: xen.Runner = xen.run_cmd) -> List[Vm]:
    names = (virsh(run, "list", "--all", "--name") or "").split()
    return [load_vm(run, n) for n in names if n != "Domain-0"]


# ---------------------------------------------------------------- placement

def is_manual(vm: Vm) -> bool:
    return vm.mode == "manual" or (bool(vm.cpuset) and vm.mode != "auto")


def to_request(vm: Vm, nodes: List[core.Node], pci_nodes: Dict[str, int],
               state: Optional[st.State] = None, now: float = 0.0) -> core.Request:
    found = (xen.pci_node(a, pci_nodes, SYSFS) for a in vm.pci)
    cards = tuple(n for n in found if n is not None)
    current = core.nodes_of_cpus(vm.cpuset, nodes) if vm.cpuset else ()
    usage = st.usage(state, vm.name) if state is not None else None
    cooling = state is not None and st.in_cooldown(state, vm.name, now)
    home = st.home(state, vm.name, vm.domid) if state is not None else ()
    return core.Request(vm.name, vm.vcpus, vm.guaranteed_mb, cards, current,
                        vm.mode == "auto", is_manual(vm), vm.elastic, usage, cooling, home,
                        core.lane_of(vm.cpuset, nodes), bool(vm.pci))


def measure_usage(run: xen.Runner, vms: List[Vm], seconds: float) -> Dict[str, float]:
    """pCPU consommés par chaque VM pendant « seconds » secondes (0 si arrêtée)."""
    times = st.measure(lambda: xen.domain_cpu_times(run, by_name=True), seconds)
    return {vm.name: times.get(vm.name, 0.0) for vm in vms}


def build_plan(nodes: List[core.Node], pci_nodes: Dict[str, int], vms: List[Vm],
               cores_only: bool = False, rebalance: bool = False,
               reserved_mb: Optional[Dict[int, int]] = None,
               state: Optional[st.State] = None, now: float = 0.0,
               spread: bool = False) -> List[Tuple[Vm, core.Placement]]:
    reqs = [to_request(v, nodes, pci_nodes, state, now) for v in vms]
    placements = core.plan(nodes, reqs, cores_only, rebalance, reserved_mb, spread)
    return [(vm, placements[vm.name]) for vm in sorted(vms, key=lambda v: v.name)]


# ---------------------------------------------------------------- application

def placed_xml(vm: Vm, p: core.Placement) -> str:
    """Rend la définition avec le cpuset et la marque numa-place « auto »."""
    root = ET.fromstring(vm.xml)
    vcpu = root.find("vcpu")
    if vcpu is None:
        vcpu = ET.SubElement(root, "vcpu")
        vcpu.text = str(vm.vcpus)
    vcpu.set("cpuset", core.format_cpulist(p.cpus))
    meta = root.find("metadata")
    if meta is None:
        meta = ET.SubElement(root, "metadata")
    mark = meta.find("{%s}place" % NS)
    if mark is None:
        mark = ET.SubElement(meta, "{%s}place" % NS)
    mark.set("mode", "auto")
    return ET.tostring(root, encoding="unicode")


def apply_one(vm: Vm, p: core.Placement, live: bool, run: xen.Runner = xen.run_cmd) -> bool:
    if vm.cpuset != p.cpus or vm.mode != "auto":
        fd, path = tempfile.mkstemp(suffix=".xml")
        try:
            with os.fdopen(fd, "w") as fh:
                fh.write(placed_xml(vm, p))
            if virsh(run, "define", path) is None:
                return False
        finally:
            os.unlink(path)
        log("{}: nœud(s) {} ({}) — mémoire placée au prochain démarrage".format(
            vm.name, core.format_cpulist(p.node_ids), p.reason))
    if live and vm.running:
        return xen.pin_live(vm.name, p.cpus, run)
    return True


# ---------------------------------------------------------------- CLI

def show_plan(pairs: List[Tuple[Vm, core.Placement]], state: Optional[st.State] = None) -> None:
    for vm, p in pairs:
        where = "nœud {:<5}".format(core.format_cpulist(p.node_ids)) if p.nodes else "-" * 10
        mem = "{}-{}".format(vm.mem_min_mb, vm.mem_mb) if vm.elastic else str(vm.mem_mb)
        used = st.usage(state, vm.name) if state is not None else None
        cpu = "{:>5.1f}".format(used) if used is not None else "    -"
        print("{:<24} {:>3} vCPU {} pCPU {:>11} Mo  {}  {}".format(
            vm.name[:24], vm.vcpus, cpu, mem, where, p.reason))


def show_status(pairs: List[Tuple[Vm, core.Placement]], run: xen.Runner) -> None:
    mem = xen.domain_memory(run)
    for vm, _ in pairs:
        domid = (virsh(run, "domid", vm.name) or "").strip()
        if not domid.isdigit():
            print("{:<24} arrêtée".format(vm.name[:24]))
            continue
        cpus = core.format_cpulist(vm.cpuset) if vm.cpuset else "tous"
        print("{:<24} cpuset={} ram[{}]".format(
            vm.name[:24], cpus, xen.format_memory(mem.get(int(domid), {}))))


def main(argv: Optional[List[str]] = None, run: xen.Runner = xen.run_cmd) -> int:
    ap = argparse.ArgumentParser(description="Placement NUMA des VM Xen (libvirt)")
    ap.add_argument("cmd", choices=("plan", "apply", "status"), nargs="?", default="plan")
    ap.add_argument("vms", nargs="*", help="noms des VM (défaut : toutes)")
    ap.add_argument("--live", action="store_true", help="épingle aussi les vCPU des VM en marche")
    ap.add_argument("--rebalance", action="store_true", help="recalcule aussi les VM déjà placées")
    ap.add_argument("--cores-only", action="store_true",
                    help="capacité d'un nœud = cœurs physiques (les threads SMT ne comptent pas)")
    ap.add_argument("--smt-share", action="store_true",
                    help="autorise deux threads d'un même cœur dans une VM (défaut : jamais)")
    ap.add_argument("--sample", type=float, default=10.0, metavar="S",
                    help="mesure la charge CPU réelle pendant S secondes (0 : nominale)")
    args = ap.parse_args(argv)

    nodes, pci_nodes = xen.read_topology(run)
    if len(nodes) < 2:
        log("un seul nœud NUMA visible : rien à faire (vérifiez le BIOS, ex. NPS/interleaving)")
        return 0
    vms, now = load_vms(run), time.time()
    # RAM du dom0 réservée dans le calcul (Xen ne la déplace pas), relue au plus 1 fois/h
    dom0, saved = xen.dom0_memory_cached(run, st.load(STATE), now)
    log("dom0 : " + xen.format_memory(dom0))
    state = None
    if args.sample > 0 and args.cmd != "status":
        state = st.smooth(saved, measure_usage(run, vms, args.sample))
    pairs = build_plan(nodes, pci_nodes, vms, args.cores_only, args.rebalance, dom0, state, now,
                       spread=not args.smt_share)
    selected = [(vm, p) for vm, p in pairs if not args.vms or vm.name in args.vms]
    if args.cmd == "plan":
        show_plan(selected, state)
    elif args.cmd == "status":
        show_status(selected, run)
    else:
        results = [apply_one(vm, p, args.live, run) for vm, p in selected if p.nodes]
        moves = {vm.name: (before, p.node_ids) for vm, p in selected if p.nodes and vm.cpuset
                 for before in [core.nodes_of_cpus(vm.cpuset, nodes)] if before != p.node_ids}
        boots = {vm.name: vm.domid for vm, _ in selected}
        st.save(STATE, st.record_moves(state if state is not None else saved, moves, boots, now))
        return 0 if all(results) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
