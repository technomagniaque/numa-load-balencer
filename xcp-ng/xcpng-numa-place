#!/usr/bin/env python3
"""xcpng-numa-place — placement NUMA automatique des VM XCP-ng (8.3) :
vCPU et mémoire sur le(s) même(s) nœud(s), en tenant compte du passthrough PCI.

  xcpng-numa-place plan [--rebalance] [--cores-only]
  xcpng-numa-place apply [--live] [--rebalance] [--cores-only] [NOM|UUID...]
  xcpng-numa-place status

Règles (calcul dans numa_core.py, topologie lue par numa_xen.py via « xl info -n ») :
  - VM avec other-config:pci -> nœud de la carte
  - VM sans passthrough -> nœud(s) le(s) moins chargé(s), puis conservé(s)
  - VM plus grande qu'un nœud -> plusieurs nœuds CONTIGUS
  - tag « numa-manual », ou VCPUs-params:mask posé à la main sans tag « numa-auto » -> ignorée

Application : VCPUs-params:mask (affinité dure). Xen en déduit l'affinité de nœud
du domaine et y alloue sa mémoire au démarrage suivant. --live épingle aussi les
vCPU tout de suite (xl vcpu-pin) ; la mémoire ne bouge qu'au redémarrage de la VM.
Ballooning (DMC) : seule la mémoire garantie (memory-dynamic-min) compte dans la
charge des nœuds ; au-delà, Xen alloue sur le nœud de la VM tant qu'il a de la place.
Équilibrage sur la charge réelle : à chaque passage, la consommation CPU de chaque
VM est mesurée (--sample S secondes, xl list) puis lissée dans STATE. Une petite VM
dont les nœuds sont saturés (ex. une grosse VM devenue active) est évacuée à chaud
(--live) ; elle ne rebouge pas avant 10 minutes.
Compatible Python 3.6 (dom0 XCP-ng 8.3).
"""
import argparse
import os
import re
import sys
import time
from typing import Dict, List, NamedTuple, Optional, Tuple


def _import_libs():
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (here, os.path.dirname(here), "/usr/local/lib/numa-place"):
        if os.path.exists(os.path.join(d, "numa_core.py")):
            sys.path.insert(0, d)
            break


_import_libs()
import numa_core as core  # noqa: E402
import numa_state as st  # noqa: E402
import numa_xen as xen  # noqa: E402

TAG_AUTO = "numa-auto"
TAG_MANUAL = "numa-manual"
INVENTORY = os.environ.get("XNP_INVENTORY", "/etc/xensource-inventory")
STATE = os.environ.get("XNP_STATE", "/var/lib/numa-place/xcpng-state.json")
SYSFS = os.environ.get("XNP_SYSFS", "/sys")


def log(msg: str) -> None:
    print("xcpng-numa-place: " + msg, file=sys.stderr)


class Vm(NamedTuple):
    uuid: str
    name: str
    vcpus: int
    mem_mb: int
    pci: Tuple[str, ...]
    tags: Tuple[str, ...]
    mask: Tuple[int, ...]       # VCPUs-params:mask, () si absent
    domid: Optional[int]        # None si arrêtée
    mem_min_mb: int = 0         # memory-dynamic-min (plancher du ballooning)

    @property
    def guaranteed_mb(self) -> int:
        return self.mem_mb if not self.elastic else self.mem_min_mb

    @property
    def elastic(self) -> bool:
        # passthrough PCI : toute la RAM est allouée et verrouillée (pas de
        # populate-on-demand sous Xen, DMA épinglé par VFIO) ; le ballooning ne rend rien.
        return 0 < self.mem_min_mb < self.mem_mb and not self.pci


# ---------------------------------------------------------------- lecture xe

def xe_get(run: xen.Runner, uuid: str, param: str) -> str:
    return (run(["xe", "vm-param-get", "uuid=" + uuid, "param-name=" + param]) or "").strip()


def xe_map(run: xen.Runner, uuid: str, param: str) -> Dict[str, str]:
    """Lit une map entière (« k1: v1; k2: v2 ») : une clé absente n'est pas une erreur."""
    out = {}  # type: Dict[str, str]
    for item in xe_get(run, uuid, param).split("; "):
        key, sep, val = item.partition(": ")
        if sep:
            out[key.strip()] = val.strip()
    return out


def parse_pci(value: str) -> Tuple[str, ...]:
    """other-config:pci = « 0/0000:43:00.0,0/0000:44:00.0 » -> adresses."""
    addrs = []
    for item in filter(None, (v.strip() for v in value.split(","))):
        addrs.append(item.split("/", 1)[-1].lower())
    return tuple(addrs)


def parse_tags(value: str) -> Tuple[str, ...]:
    """xe rend les tags séparés par des virgules (« , XOA, 2025.12 » sur XCP-ng 8.3)."""
    return tuple(t.strip() for t in re.split(r"[,;]", value) if t.strip())


def this_host_uuid() -> str:
    try:
        with open(INVENTORY) as fh:
            for line in fh:
                if line.startswith("INSTALLATION_UUID="):
                    return line.split("=", 1)[1].strip().strip("'\"")
    except OSError:
        pass
    return ""


def _on_this_host(run: xen.Runner, uuid: str, host: str, single_host: bool) -> bool:
    if single_host:
        return True
    return host in (xe_get(run, uuid, "resident-on"), xe_get(run, uuid, "affinity"))


def load_vm(run: xen.Runner, uuid: str) -> Vm:
    mask = xe_map(run, uuid, "VCPUs-params").get("mask", "")
    domid = xe_get(run, uuid, "dom-id")
    dyn_min = int(xe_get(run, uuid, "memory-dynamic-min") or 0) // 2**20
    return Vm(
        uuid=uuid,
        name=xe_get(run, uuid, "name-label"),
        vcpus=int(xe_get(run, uuid, "VCPUs-max") or 1),
        mem_mb=int(xe_get(run, uuid, "memory-static-max") or 0) // 2**20,
        pci=parse_pci(xe_map(run, uuid, "other-config").get("pci", "")),
        tags=parse_tags(xe_get(run, uuid, "tags")),
        mask=core.parse_cpulist(mask) if mask else (),
        domid=int(domid) if domid.isdigit() and int(domid) > 0 else None,
        mem_min_mb=dyn_min,
    )


def load_vms(run: xen.Runner = xen.run_cmd) -> List[Vm]:
    uuids = (run(["xe", "vm-list", "is-control-domain=false", "is-a-snapshot=false",
                  "is-a-template=false", "--minimal"]) or "").strip()
    hosts = [h for h in (run(["xe", "host-list", "--minimal"]) or "").strip().split(",") if h]
    host = this_host_uuid()
    return [load_vm(run, u) for u in filter(None, uuids.split(","))
            if _on_this_host(run, u, host, len(hosts) <= 1)]


# ---------------------------------------------------------------- placement

def is_auto(vm: Vm) -> bool:
    return TAG_AUTO in vm.tags


def is_manual(vm: Vm) -> bool:
    return TAG_MANUAL in vm.tags or (bool(vm.mask) and not is_auto(vm))


def to_request(vm: Vm, nodes: List[core.Node], pci_nodes: Dict[str, int],
               state: Optional[st.State] = None, now: float = 0.0) -> core.Request:
    found = (xen.pci_node(a, pci_nodes, SYSFS) for a in vm.pci)
    cards = tuple(n for n in found if n is not None)
    current = core.nodes_of_cpus(vm.mask, nodes) if vm.mask else ()
    usage = st.usage(state, vm.uuid) if state is not None else None
    cooling = state is not None and st.in_cooldown(state, vm.uuid, now)
    home = st.home(state, vm.uuid, boot_id(vm)) if state is not None else ()
    return core.Request(vm.uuid, vm.vcpus, vm.guaranteed_mb, cards, current,
                        is_auto(vm), is_manual(vm), vm.elastic, usage, cooling, home,
                        core.lane_of(vm.mask, nodes), bool(vm.pci))


def boot_id(vm: Vm) -> str:
    """Change à chaque démarrage : la RAM est alors réallouée là où tourne la VM."""
    return str(vm.domid) if vm.domid else ""


def measure_usage(run: xen.Runner, vms: List[Vm], seconds: float) -> Dict[str, float]:
    """pCPU consommés par chaque VM pendant « seconds » secondes (0 si arrêtée)."""
    times = st.measure(lambda: xen.domain_cpu_times(run), seconds)
    return {vm.uuid: times.get(str(vm.domid), 0.0) if vm.domid else 0.0 for vm in vms}


def build_plan(nodes: List[core.Node], pci_nodes: Dict[str, int], vms: List[Vm],
               cores_only: bool = False, rebalance: bool = False,
               reserved_mb: Optional[Dict[int, int]] = None,
               state: Optional[st.State] = None, now: float = 0.0,
               spread: bool = False) -> List[Tuple[Vm, core.Placement]]:
    reqs = [to_request(vm, nodes, pci_nodes, state, now) for vm in vms]
    placements = core.plan(nodes, reqs, cores_only, rebalance, reserved_mb, spread)
    return [(vm, placements[vm.uuid]) for vm in sorted(vms, key=lambda v: v.name)]


# ---------------------------------------------------------------- application

def apply_one(vm: Vm, p: core.Placement, live: bool, run: xen.Runner = xen.run_cmd) -> bool:
    ok = True
    if vm.mask != p.cpus:
        mask = ",".join(str(c) for c in p.cpus)
        ok = run(["xe", "vm-param-set", "uuid=" + vm.uuid, "VCPUs-params:mask=" + mask]) is not None
        if ok:
            log("{}: nœud(s) {} ({}) — mémoire placée au prochain démarrage".format(
                vm.name, core.format_cpulist(p.node_ids), p.reason))
    if ok and not is_auto(vm):
        ok = run(["xe", "vm-param-add", "uuid=" + vm.uuid, "param-name=tags",
                  "param-key=" + TAG_AUTO]) is not None
    if ok and live and vm.domid is not None:
        ok = xen.pin_live(str(vm.domid), p.cpus, run)
    return ok


# ---------------------------------------------------------------- CLI

def show_plan(pairs: List[Tuple[Vm, core.Placement]], state: Optional[st.State] = None) -> None:
    for vm, p in pairs:
        where = "nœud {:<5}".format(core.format_cpulist(p.node_ids)) if p.nodes else "-" * 10
        mem = "{}-{}".format(vm.mem_min_mb, vm.mem_mb) if vm.elastic else str(vm.mem_mb)
        used = st.usage(state, vm.uuid) if state is not None else None
        cpu = "{:>5.1f}".format(used) if used is not None else "    -"
        print("{:<24} {:>3} vCPU {} pCPU {:>11} Mo  {}  {}".format(
            vm.name[:24], vm.vcpus, cpu, mem, where, p.reason))


def show_status(pairs: List[Tuple[Vm, core.Placement]], run: xen.Runner) -> None:
    mem = xen.domain_memory(run)
    for vm, _ in pairs:
        if vm.domid is None:
            state = "arrêtée"
        else:
            mask = core.format_cpulist(vm.mask) if vm.mask else "tous"
            state = "mask={} ram[{}]".format(mask, xen.format_memory(mem.get(vm.domid, {})))
        print("{:<24} {}".format(vm.name[:24], state))


def main(argv: Optional[List[str]] = None, run: xen.Runner = xen.run_cmd) -> int:
    ap = argparse.ArgumentParser(description="Placement NUMA des VM XCP-ng")
    ap.add_argument("cmd", choices=("plan", "apply", "status"), nargs="?", default="plan")
    ap.add_argument("vms", nargs="*", help="noms ou UUID (défaut : toutes)")
    ap.add_argument("--live", action="store_true", help="épingle aussi les vCPU des VM en marche")
    ap.add_argument("--rebalance", action="store_true", help="recalcule aussi les VM déjà placées")
    ap.add_argument("--cores-only", action="store_true",
                    help="capacité d'un nœud = cœurs physiques (les threads SMT ne comptent pas)")
    ap.add_argument("--smt-share", action="store_true",
                    help="autorise deux threads d'un même cœur dans une VM (défaut : jamais)")
    ap.add_argument("--sample", type=float, default=10.0, metavar="S",
                    help="mesure la charge CPU réelle pendant S secondes (0 : nominale)")
    args = ap.parse_args(argv)

    nodes, pci_nodes = xen.read_topology(run)
    if len(nodes) < 2:
        log("un seul nœud NUMA visible : rien à faire (vérifiez le BIOS, ex. NPS/interleaving)")
        return 0
    vms, now = load_vms(run), time.time()
    # RAM du dom0 réservée dans le calcul (Xen ne la déplace pas), relue au plus 1 fois/h
    dom0, saved = xen.dom0_memory_cached(run, st.load(STATE), now)
    log("dom0 : " + xen.format_memory(dom0))
    state = None
    if args.sample > 0 and args.cmd != "status":
        state = st.smooth(saved, measure_usage(run, vms, args.sample))
    pairs = build_plan(nodes, pci_nodes, vms, args.cores_only, args.rebalance, dom0, state, now,
                       spread=not args.smt_share)
    selected = [(vm, p) for vm, p in pairs
                if not args.vms or vm.name in args.vms or vm.uuid in args.vms]
    if args.cmd == "plan":
        show_plan(selected, state)
    elif args.cmd == "status":
        show_status(selected, run)
    else:
        results = [apply_one(vm, p, args.live, run) for vm, p in selected if p.nodes]
        moves = {vm.uuid: (before, p.node_ids) for vm, p in selected if p.nodes and vm.mask
                 for before in [core.nodes_of_cpus(vm.mask, nodes)] if before != p.node_ids}
        boots = {vm.uuid: boot_id(vm) for vm, _ in selected}
        st.save(STATE, st.record_moves(state if state is not None else saved, moves, boots, now))
        return 0 if all(results) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
